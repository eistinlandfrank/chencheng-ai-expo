# Use a unique random value of at least 32 characters. Never commit the real value.
DATABASE_PATH=/data/expo-service.sqlite
PUBLIC_SITE_URL=https://expo.example.com
ANALYTICS_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
APP_ORIGIN=https://expo.example.com
WEBAUTHN_RP_ID=expo.example.com
WEBAUTHN_RP_NAME=Expo Service AI
AUTH_BOOTSTRAP_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional server-side AI assistant. Do not expose the key to browsers or commit a real value.
VECTRUST_API_KEY=replace-with-your-server-side-api-key
AI_BASE_URL=https://api.openai-next.com/v1
AI_MODEL=deepseek-v4-flash
