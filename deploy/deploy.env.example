DEPLOY_ROOT=/mnt/nvme0n1-4/apps/chencheng-ai-expo
APP_DOCKER_HOST=unix:///var/run/docker.sock
SOURCE_DIR=/mnt/nvme0n1-4/apps/chencheng-ai-expo/source
RELEASE_ROOT=/mnt/nvme0n1-4/apps/chencheng-ai-expo/releases
BACKUP_ROOT=/mnt/nvme0n1-4/apps/chencheng-ai-expo/backups
STATE_DIR=/mnt/nvme0n1-4/apps/chencheng-ai-expo/deploy-state
DEPLOY_QUEUE_DIR=/mnt/nvme0n1-4/apps/chencheng-ai-expo/deploy-queue
SECRETS_DIR=/mnt/nvme0n1-4/apps/chencheng-ai-expo/secrets
PLATFORM_DATA_DIR=/mnt/nvme0n1-4/apps/chencheng-ai-expo/data
GATEWAY_HOST_PORT=3100
PLATFORM_HOST_PORT=3111
VISITOR_HOST_PORT=3112
WEBHOOK_HOST_PORT=3113
# Temporary MVP switch: true exposes the exhibitor and operations portals as read-only demos.
PUBLIC_PORTAL_SHOWCASE=true
# Set only for the first migration from the previous single-container release.
LEGACY_PLATFORM_CONTAINER=
