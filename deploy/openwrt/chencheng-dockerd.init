#!/bin/sh /etc/rc.common

START=94
STOP=6
USE_PROCD=1

APP_ROOT=/mnt/nvme0n1-4/apps/chencheng-ai-expo
RUNTIME_ROOT=$APP_ROOT/runtime

start_service() {
  mkdir -p "$RUNTIME_ROOT/data" "$RUNTIME_ROOT/exec"

  procd_open_instance
  procd_set_param command /usr/bin/dockerd \
    --data-root="$RUNTIME_ROOT/data" \
    --exec-root="$RUNTIME_ROOT/exec" \
    --pidfile="$RUNTIME_ROOT/dockerd.pid" \
    --host="unix://$RUNTIME_ROOT/docker.sock" \
    --storage-driver=vfs \
    --bridge=none \
    --iptables=false \
    --ip-forward=false \
    --ip-masq=false \
    --userland-proxy=false \
    --log-level=warn
  procd_set_param respawn 3600 5 5
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
