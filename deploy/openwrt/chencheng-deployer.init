#!/bin/sh /etc/rc.common

START=96
STOP=10
USE_PROCD=1

start_service() {
  procd_open_instance
  procd_set_param command /mnt/nvme0n1-4/apps/chencheng-ai-expo/source/deploy/webhook-worker-daemon.sh
  procd_set_param env DEPLOY_ROOT=/mnt/nvme0n1-4/apps/chencheng-ai-expo
  procd_set_param respawn 10 5 0
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
