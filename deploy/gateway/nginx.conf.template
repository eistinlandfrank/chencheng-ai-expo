pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
  worker_connections 1024;
}

http {
  access_log /dev/stdout;
  client_body_temp_path /tmp/client_body;
  proxy_temp_path /tmp/proxy;
  fastcgi_temp_path /tmp/fastcgi;
  uwsgi_temp_path /tmp/uwsgi;
  scgi_temp_path /tmp/scgi;

  map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
  }

  map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    '' $scheme;
  }

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $forwarded_proto;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;

  server {
    listen ${GATEWAY_HOST_PORT} default_server;
    server_name _;

    location = /webhooks/github {
      proxy_pass http://127.0.0.1:${WEBHOOK_HOST_PORT};
    }

    location ^~ /api/v1/ {
      proxy_pass http://127.0.0.1:${PLATFORM_HOST_PORT};
    }

    location ~ ^/(access-denied|activate|exhibitor|login|operations)(/|$) {
      proxy_pass http://127.0.0.1:${PLATFORM_HOST_PORT};
    }

    # Both applications emit immutable assets below /_next/. Try the staff
    # platform first, then fall back to the visitor app when that asset hash
    # does not exist there.
    location ^~ /_next/ {
      proxy_intercept_errors on;
      error_page 404 = @visitor_next;
      proxy_pass http://127.0.0.1:${PLATFORM_HOST_PORT};
    }

    location @visitor_next {
      proxy_pass http://127.0.0.1:${VISITOR_HOST_PORT};
    }

    location / {
      proxy_pass http://127.0.0.1:${VISITOR_HOST_PORT};
    }
  }

}
